@page "/Game"

<PageTitle>Game</PageTitle>


<p>If I cannot do 1000 kicks then I will do 1000 punches!</p>


<p>Punches thrown: @punchesThrown</p>

<button @onclick="PunchCounter">Punch</button>


<p> @kicksCounter </p>


@code {


    private int kicksCounter = 0;

    private int punchesThrown = 0;

    private void PunchCounter()
    {
        punchesThrown++;
    }

    private void kicksCounter()
    {


        If (PunchCounter >= 10);

        kicksThrown++


    }


}
