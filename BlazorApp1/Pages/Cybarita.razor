@page "/Cybarita"
@rendermode InteractiveServer

<a href="/">Home</a>
<p>Cybarita</p>

<p>You have sipped @timesSipped times</p>

<button @onclick="SipCybarita">Sip Cybarita</button>

@if (pullOutYourGun)
{
    <p>You pull your gun out.</p>
}

@code {
    private int timesSipped = 0;
    private bool pullOutYourGun = false;

    private void SipCybarita()
    {
        timesSipped++;
        pullOutYourGun = timesSipped <= 10;
    }
}