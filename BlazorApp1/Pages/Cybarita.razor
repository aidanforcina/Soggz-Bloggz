@page "/Cybarita"

<p>Cybarita</p>

<p>You have sipped @sipCount times from your Cybarita Acoholic Beverage</p>

<button @onclick="SipCybarita">Sip Cybarita</button>

@code {
    private int sipCount = 0;
    private string gunText = "";
    private bool gunAlert = false;
    private string gunTextTwo = "";
    private string shoot = "";



    private void SipCybarita()
    {
        sipCount++;

        gunAlert = false;

        if (sipCount == 10)
        {
            gunAlert = true;
            gunText = "Pull your gun out.";
        }

        if (sipCount == 17)
        {
            gunAlert = true;
            gunTextTwo = "Pull your fucking gun out";
        }
    }
}




@if (sipCount >= 10)
{
    <div>
        <p>Pull your gun out.</p>
    </div>
}

<button @onclick="shoot">Shoot your fucking gun.</button>



@if (sipCount >= 20)
{
    <div>
        <p>Pull your fucking gun out.</p>
    </div>
}