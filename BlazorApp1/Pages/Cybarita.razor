@page "/Cybarita"

<p>Cybarita</p>

<p>You have sipped @sipCount times from your Cybarita Acoholic Beverage</p>

<button @onclick="SipCybarita">Sip Cybarita</button>

@code {
    private int sipCount = 0;
    private string gunText = "";
    private bool gunAlert = false;

    private void SipCybarita()
    {
        sipCount++;

        gunAlert = false;

        if (sipCount == 10)
        {
            gunAlert = true;
            gunText = "Pull your gun out.";
        }
    }
}

@if (gunText == "Pull your gun out.")
{
    <div>
        <p>Pull your gun out.</p>
    </div>
}