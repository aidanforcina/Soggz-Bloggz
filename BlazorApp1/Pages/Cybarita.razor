@page "/Cybarita"

<a href="/">Home</a>
<p>Cybarita</p>

<p>You have sipped @timesSipped times</p>

@if (pullOutYourGun)
{
    <p>Pull out your gun!</p>
}

<button @onclick="SipCybarita">Sip Cybarita</button>

@code {
    private int timesSipped = 0;
    private bool pullOutYourGun = false;

    private void SipCybarita()
    {
        timesSipped++;

        if (timesSipped <= 10)
        {
            pullOutYourGun = true;
        }
        else
        {
            pullOutYourGun = false;
        }
    }
}


@if (pullOutYourGun)
{
    <p>Your gun is all the way out</p>
}

@if (pullOutYourGun)
{
    <p>Would you like to pull the trigger?</p>
}

